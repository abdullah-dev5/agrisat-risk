# Direct Postgres (migrations). If db.* host fails, use pooler from Supabase dashboard:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgresSUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy HS256 only (optional if project uses ECC JWKS — default on new Supabase projects)
SUPABASE_JWT_SECRET=

# Google Earth Engine (required for Tier 3 vegetation + baseline)
GEE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee-service-account.json
GEE_PROJECT=your-gcp-project-id

# Planet API (Tier 1 — optional, after E&R approval)
PLANET_API_KEY=

# Tier 2 — GEE cloud-free weekly S2 composites (M4; no local model required)
SEN2SR_MODEL_PATH=./models/sen2sr
SEN2SR_ENABLED=true

# Pilot configuration
PILOT_CROP=wheat
PILOT_DISTRICT=matiari
PILOT_REGION_BBOX=68.0,25.2,69.2,26.1

# Risk thresholds (z-score)
RISK_THRESHOLD_WATCH=1.0
RISK_THRESHOLD_ELEVATED=1.5
RISK_THRESHOLD_HIGH=2.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
