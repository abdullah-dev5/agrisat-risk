# Direct Postgres (migrations). If db.* host fails, use pooler from Supabase dashboard:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy HS256 only (optional if project uses ECC JWKS — default on new Supabase projects)
SUPABASE_JWT_SECRET=

# Google Earth Engine (required for Tier 3 vegetation + baseline)
GEE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./gee-service-account.json
GEE_PROJECT=your-gcp-project-id

# Planet API (Tier 1 — optional, after E&R approval)
PLANET_API_KEY=

# Tier 2 — local SEN2SR model (preferred) or GEE weekly composites fallback
SEN2SR_MODEL_PATH=./models/sen2sr
SEN2SR_ENABLED=true
SEN2SR_USE_LOCAL=true

# M12 — gradient-boosted crop stress model (scripts/train_ml_risk_model.py)
ML_RISK_ENABLED=true
ML_RISK_MODEL_PATH=./models/ml_risk
ML_RISK_ELEVATE_ONLY=true
ML_RISK_CONFIDENCE_MIN=0.55

# Production hardening
APP_ENV=development
ALLOW_OPEN_REGISTRATION=true
REGISTRATION_SECRET=
HEALTH_DETAIL_ENABLED=true
BASELINE_BUILD_ON_REQUEST=false
TRUSTED_HOSTS=

# Pilot configuration
PILOT_CROP=wheat
PILOT_DISTRICT=matiari
PILOT_REGION_BBOX=68.0,25.2,69.2,26.1

# Risk thresholds (z-score)
RISK_THRESHOLD_WATCH=1.0
RISK_THRESHOLD_ELEVATED=1.5
RISK_THRESHOLD_HIGH=2.0

# CORS — comma-separated production origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
